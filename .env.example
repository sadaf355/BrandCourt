# Local Docker Compose defaults. Replace secrets and provider values before deployment.
APP_ENV=development
PORT=8000
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
POSTGRES_PASSWORD=change-this-local-demo-password
DATABASE_URL=postgresql+asyncpg://brandcourt:change-this-local-demo-password@db:5432/brandcourt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOB_WORKER_ENABLED=true
MODEL_MODE=deterministic
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
