# Environment & Server
APP_ENV=production                                                  # Application runtime environment (production / development / staging)
PORT=8000                                                           # Server listening port
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes      # Secret key for JWT signing (must be >= 32 bytes in production)

# Database & CORS
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xyz.region.neon.tech/neondb?ssl=require  # Neon PostgreSQL non-pooled connection URL (must be non-pooled for Alembic migrations)
CORS_ORIGINS=https://brandcourt.vercel.app                          # Allowed browser origins without trailing slashes

# Storage & S3 Settings
STORAGE_BACKEND=s3                                                  # Storage driver for uploaded creatives (s3 for production, local for disk)
S3_BUCKET=brandcourt-creatives                                      # Target S3 or Cloudflare R2 bucket name
S3_REGION=us-east-1                                                 # AWS region or 'auto' for Cloudflare R2
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com       # S3/R2 compatible endpoint URL (omit for default AWS S3)
S3_ACCESS_KEY_ID=your-s3-access-key-id                              # S3 or R2 API access key ID
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key                      # S3 or R2 API secret access key
UPLOAD_DIR=./uploads                                                # Local fallback folder when STORAGE_BACKEND=local

# Worker & Review Engine
JOB_WORKER_ENABLED=true                                             # Enables the durable in-process Claim Court review queue worker
MODEL_MODE=deterministic                                            # Review engine execution mode (deterministic for heuristics, ollama for local LLM)

# Demo Mode & Governance
DEMO_LOGIN_ENABLED=true                                             # Enables one-click passwordless Demo button authentication
DEMO_ADMIN_EMAIL=demo-admin@glowserum.com                           # Default admin email for the shared demo workspace
DEMO_RESET_ON_START=false                                           # Re-seeds demo data on start (set true once on initial deploy, then false to preserve judge edits)
LOGIN_MAX_FAILURES=10                                               # Maximum failed sign-in attempts per client IP before temporary lockout
