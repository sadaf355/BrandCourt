APP_NAME=BrandCourt API
APP_ENV=development
APP_VERSION=2.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./brandcourt.db  # Production: paste your Neon URL; postgres:// URLs are normalized automatically
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_MINUTES=30
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOB_WORKER_ENABLED=false

DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_EMAIL=demo-admin@glowserum.com
DEMO_RESET_ON_START=false

MODEL_MODE=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

OLLAMA_EMBEDDING_MODEL=nomic-embed-text
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
